# What the installer downloads: one pinned version of each tool, with the
# SHA-256 of every file, so an install today and a year from now give the
# same editor and players. Read by setup.sh (bash) and setup.ps1 (PowerShell):
# KEY=value lines only, no quotes, no spaces around "=".
# An empty *_SHA256 skips the check (for a release not published yet).

# VSCodium: https://github.com/VSCodium/vscodium/releases (sums: the .sha256 next to each file)
VSCODIUM_VERSION=1.135.06055
VSCODIUM_WIN_URL=https://github.com/VSCodium/vscodium/releases/download/1.135.06055/VSCodium-win32-x64-1.135.06055.zip
VSCODIUM_WIN_SHA256=0bec978f201238624bc9ad43966f5e201ed8afacc37d77035a822252d9c9c200
VSCODIUM_MAC_ARM_URL=https://github.com/VSCodium/vscodium/releases/download/1.135.06055/VSCodium-darwin-arm64-1.135.06055.zip
VSCODIUM_MAC_ARM_SHA256=61ff9ebc3ac5563c63a0a9e1b479822647e7f2c3303b0629f15fefe9e291f7cc
VSCODIUM_MAC_X64_URL=https://github.com/VSCodium/vscodium/releases/download/1.135.06055/VSCodium-darwin-x64-1.135.06055.zip
VSCODIUM_MAC_X64_SHA256=2fce180317a011576dc7e0910e1033d3287472b56e362b33175f5416415b604a
VSCODIUM_LINUX_URL=https://github.com/VSCodium/vscodium/releases/download/1.135.06055/VSCodium-linux-x64-1.135.06055.tar.gz
VSCODIUM_LINUX_SHA256=c09d8ac8dd7f52b09ee159ee24b440541dfd8f937a0f6f88cc428c78e48ee1f2

